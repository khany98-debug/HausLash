# Database
DATABASE_URL=postgresql://user:password@db.neon.tech:5432/hauslash?sslmode=require

# Stripe
# Use pk_live/sk_live for production. Keep test keys only in local/preview.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Admin and scheduled jobs
ADMIN_PASSWORD=change_this_to_a_long_random_password
CRON_SECRET=change_this_to_a_different_long_random_secret

# Email Service (Resend)
RESEND_API_KEY=re_xxxxx
# Must be a sender/domain verified in Resend.
RESEND_FROM_ADDRESS=Hauslash <noreply@hauslash.co.uk>
# Public reply/admin inbox.
ADMIN_EMAIL=Hauslash@outlook.com

# YouTube Video (for home page video showcase)
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=

# Optional: Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://hauslash.co.uk
